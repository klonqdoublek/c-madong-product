{
  "type": "flex",
  "altText": "💸 ค่าหอพักเดือน{month} ฿{totalAmount} — อย่าลืมจ่ายนะ",
  "contents": {
    "type": "bubble",
    "size": "mega",
    "hero": {
      "type": "box",
      "layout": "vertical",
      "contents": [
        {
          "type": "image",
          "url": "https://ik.imagekit.io/atlantis65/Banner%20-%20flex%20test.jpg",
          "size": "full",
          "aspectRatio": "16:9",
          "aspectMode": "cover"
        },
        {
          "type": "box",
          "layout": "vertical",
          "contents": [
            {
              "type": "text",
              "text": "ค่าหอพักเดือนมกราคม",
              "color": "#FFFFFF",
              "size": "xs",
              "wrap": true
            },
            {
              "type": "text",
              "text": "฿3,921.08",
              "color": "#FFFFFF",
              "size": "3xl",
              "weight": "bold"
            },
            {
              "type": "box",
              "layout": "horizontal",
              "contents": [
                {
                  "type": "box",
                  "layout": "vertical",
                  "contents": [
                    {
                      "type": "text",
                      "text": "รอบที่ 1",
                      "size": "xxs",
                      "color": "#565655",
                      "weight": "bold",
                      "align": "center"
                    }
                  ],
                  "backgroundColor": "#F9E1E9",
                  "cornerRadius": "xl",
                  "paddingAll": "xs",
                  "flex": 0,
                  "width": "52px",
                  "height": "18px",
                  "justifyContent": "center"
                },
                {
                  "type": "text",
                  "text": "5 กุมภาพันธ์ 2569 เวลา 17.30น.",
                  "color": "#FFFFFF",
                  "size": "xs",
                  "margin": "sm",
                  "flex": 1
                }
              ],
              "alignItems": "center",
              "margin": "md"
            },
            {
              "type": "text",
              "text": "*นำเงินเข้าก่อนเวลา 17.30น. 5 กุมภาพันธ์ 2569",
              "color": "#FFFFFF99",
              "size": "xxs",
              "wrap": true,
              "margin": "xs"
            }
          ],
          "position": "absolute",
          "offsetTop": "0px",
          "offsetStart": "0px",
          "width": "100%",
          "height": "100%",
          "paddingAll": "xl",
          "justifyContent": "center"
        }
      ],
      "paddingAll": "0px",
      "action": {
        "type": "uri",
        "label": "ดูรายละเอียด",
        "uri": "https://liff.line.me/{liffId}/billing/{billId}"
      }
    },
    "body": {
      "type": "box",
      "layout": "vertical",
      "spacing": "lg",
      "contents": [
        {
          "type": "text",
          "text": "• พิชญา พูลเพียร - ชวนชม - 1116 - เตียง B •",
          "size": "xs",
          "color": "#565655",
          "align": "center",
          "wrap": true
        },
        {
          "type": "box",
          "layout": "vertical",
          "spacing": "xs",
          "contents": [
            {
              "type": "box",
              "layout": "horizontal",
              "contents": [
                { "type": "text", "text": "ค่าห้อง", "size": "sm", "color": "#565655", "flex": 4 },
                { "type": "text", "text": "3,500.00", "size": "sm", "color": "#565655", "weight": "bold", "align": "end", "flex": 2 }
              ]
            },
            {
              "type": "box",
              "layout": "horizontal",
              "contents": [
                { "type": "text", "text": "ค่าประกัน", "size": "sm", "color": "#565655", "flex": 4 },
                { "type": "text", "text": "0.00", "size": "sm", "color": "#565655", "weight": "bold", "align": "end", "flex": 2 }
              ]
            },
            {
              "type": "box",
              "layout": "horizontal",
              "contents": [
                { "type": "text", "text": "ค่าไฟเดือนที่แล้ว", "size": "sm", "color": "#565655", "flex": 4 },
                { "type": "text", "text": "314.00", "size": "sm", "color": "#565655", "weight": "bold", "align": "end", "flex": 2 }
              ]
            },
            {
              "type": "box",
              "layout": "horizontal",
              "contents": [
                { "type": "text", "text": "ค่าน้ำเดือนที่แล้ว", "size": "sm", "color": "#565655", "flex": 4 },
                { "type": "text", "text": "17.00", "size": "sm", "color": "#565655", "weight": "bold", "align": "end", "flex": 2 }
              ]
            },
            {
              "type": "box",
              "layout": "horizontal",
              "contents": [
                { "type": "text", "text": "ค่าปรับ", "size": "sm", "color": "#565655", "flex": 4 },
                { "type": "text", "text": "00.00", "size": "sm", "color": "#565655", "weight": "bold", "align": "end", "flex": 2 }
              ]
            }
          ]
        },
        { "type": "separator", "color": "#E5E7EB" },
        {
          "type": "box",
          "layout": "horizontal",
          "contents": [
            { "type": "text", "text": "รวมทั้งหมด", "size": "sm", "color": "#1E1E1E", "weight": "bold", "flex": 4 },
            { "type": "text", "text": "3,831.00", "size": "sm", "color": "#1E1E1E", "weight": "bold", "align": "end", "flex": 2 }
          ]
        }
      ],
      "paddingAll": "xl"
    },
    "footer": {
      "type": "box",
      "layout": "vertical",
      "spacing": "md",
      "contents": [
        {
          "type": "button",
          "style": "primary",
          "color": "#DD598B",
          "height": "sm",
          "action": {
            "type": "postback",
            "label": "🔔 เตือนฉันอีกครั้ง!",
            "data": "action=remind_bill&bill_id={billId}",
            "displayText": "เตือนฉันอีกครั้งนะ"
          }
        },
        {
          "type": "button",
          "style": "link",
          "height": "sm",
          "action": {
            "type": "postback",
            "label": "✅ ฉันนำเงินเข้าบัญชีแล้ว",
            "data": "action=confirm_payment&bill_id={billId}",
            "displayText": "ฉันนำเงินเข้าบัญชีแล้ว"
          },
          "color": "#0059FF"
        }
      ],
      "paddingAll": "lg"
    },
    "styles": {
      "footer": {
        "separator": true
      }
    }
  }
}
