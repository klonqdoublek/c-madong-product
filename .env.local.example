# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# LINE
# LIFF ID from the LIFF app inside your LINE MINI App channel
# (LINE Developer Console → Provider → Mini App channel → LIFF)
NEXT_PUBLIC_LINE_LIFF_ID=your-mini-app-liff-id
# LINE Login channel (separate from Mini App channel — handles web OAuth)
LINE_LOGIN_CHANNEL_ID=your-login-channel-id
LINE_LOGIN_CHANNEL_SECRET=your-login-channel-secret
# LINE Mini App channel ID — LIFF tokens issued by Mini App channel use this client_id
LINE_MINI_APP_CHANNEL_ID=your-mini-app-channel-id
# Messaging API channel (rich menus, push notifications, webhook)
LINE_CHANNEL_ACCESS_TOKEN=your-messaging-api-access-token
# Rich menu IDs (set by running: npx tsx scripts/setup-rich-menus.ts --deploy-liff)
RICH_MENU_GUEST=your-rich-menu-guest-id
RICH_MENU_REGISTERED=your-rich-menu-registered-id

# LINE Group (Technician notifications)
LINE_TECHNICIAN_GROUP_ID=C6f5554168121fc89b92beb1c09f405dc

# Vercel Cron (daily digest auth)
CRON_SECRET=generate-random-32-byte-hex-here

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Typhoon OCR (Thai poster text extraction — https://opentyphoon.ai)
TYPHOON_OCR_API_KEY=your-typhoon-ocr-api-key

